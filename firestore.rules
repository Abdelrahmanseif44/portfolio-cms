rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public, read-only content — writable only by verified admins.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hero/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /about/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /contact/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /navigation/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form submissions — anyone can create, only admins can read/manage.
    match /messages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'message'])
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Admin allowlist — never client-writable. Add admin UIDs from the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
